      <summary>Horizontal position offset on desktop</summary>
    </key>
    <key name="position-y" type="i">
      <default>-1</default>
      <summary>Vertical position offset on desktop</summary>
    </key>
    <key name="lock-position" type="b">
      <default>false</default>
      <summary>Lock position to prevent dragging</summary>
    </key>
    <key name="use-24h" type="b">
      <default>false</default>
