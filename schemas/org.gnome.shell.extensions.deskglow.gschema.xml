    </key>
    <key name="show-seconds" type="b">
      <default>false</default>
      <summary>Show seconds in clock</summary>
    </key>
    <key name="show-background" type="b">
      <default>true</default>
      <summary>Show background container box</summary>
    </key>
    <key name="bg-opacity" type="d">
